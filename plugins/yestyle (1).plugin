ALL_DICTS = dict(sorted(ALL_DICTS.items(), key=lambda x: len(x[0]), reverse=True))

class YeStylePlugin(BasePlugin):
    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self.chat_toggles = {}
        
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.CHAT_ACTION_MENU,
            text="YeStyle: Вкл/Выкл",
            icon="msg_settings",
            on_click=self._toggle_chat_action
        ))

    def _toggle_chat_action(self, ctx):
        dialog_id = ctx.get("dialog_id")
        if dialog_id is not None:
            current = self.chat_toggles.get(dialog_id, True)
            self.chat_toggles[dialog_id] = not current
            state = "включен ✅" if not current else "выключен ❌"
            
            try:
                import zwylib
                if hasattr(zwylib, 'toast'):
                    zwylib.toast(f"YeStyle {state}!")
            except Exception:
                pass

    def create_settings(self):
        return [
            Header(text="YeStyle ~"),
            Switch(
                key="extreme_mode",
                text="Экстремальный режим",
                default=False,
                subtext="Максимальная кавайность в каждом слове",
            ),
            Divider(text="Замена слов"),
            Switch(
                key="add_kawai_words",
                text="Кавайные слова",
                default=True,
                subtext="Заменяет слова на милые аналоги",
            ),
            Switch(
                key="nyacator",
                text="Някатор",
                default=False,
                subtext="Слегка заменяет 'на' и 'ма' (напр. 'понимяю')",
            ),
            Switch(
                key="replace_r_l",
                text="Замена р/л на в",
                default=True,
                subtext="Р/Л -> В (фембойский стиль)",
            ),
            Divider(text="Стиль текста"),
            Switch(
                key="add_suffix",
                text="Суффиксы",
                default=True,
                subtext="Добавляет -ик, -чик, -ичка к словам",
            ),
            Switch(
                key="lowercase",
                text="Убрать заглавные буквы",
                default=True,
                subtext="Делает первую букву строчной",
            ),
            Switch(
                key="upper_case",
                text="Случайный верхний регистр",
                default=False,
                subtext="Иногда делает буквы заглавными",
            ),
            Divider(text="Декор и Пунктуация"),
            Switch(
                key="emoji_punct",
                text="Эмодзи-пунктуация",
                default=True,
                subtext="Заменяет '!' и '?' на милые блестки/эмодзи",
            ),
            Switch(
                key="add_tilde",
                text="Тильда в конце",
                default=True,
                subtext="Добавляет ~ в конец сообщения",
            ),
            Switch(
                key="add_kaomoji",
                text="Каомодзи",
                default=True,
                subtext="Добавляет ^_^, UwU, :3 в конец",
            ),
        ]

    def _transform(self, text):
        if not text or not text.strip():
            return text
            
        text = text.strip()
        if text.startswith(("/", "!")):
            return text
            
        use_kawaii = self.get_setting("add_kawai_words", True)
        use_suffix = self.get_setting("add_suffix", True)
        use_nyacator = self.get_setting("nyacator", False)
        
        is_extreme = self.get_setting("extreme_mode", False)
        intensity = 2.5 if is_extreme else 1.0
        
        use_emoji_punct = self.get_setting("emoji_punct", True)
        punct_chance = 0.3 if use_emoji_punct else 0.0
        
        tokens = re.split(r'(\s+)', text)
        new_tokens = []
        
        verb_endings = ("ать", "еть", "ить", "оть", "уть", "ыть", "ти", "ял", "ел", "ил", "ал", "ут", "ют", "ат", "ят", "ешь", "ишь", "тся", "ться", "сь", "ся", "у", "ю", "ем", "им", "те", "йте")
        adj_endings = ("ый", "ий", "ой", "ая", "яя", "ое", "ее", "ые", "ие", "ому", "ему", "ыми", "ими", "ых", "их", "ую", "юю")
        cute_endings = ("ик", "чик", "чка", "шка", "ень", "уся", "очка", "ечка", "онька", "енька")
        
        first_word_processed = False
        
        for w in tokens:
            if not w.strip():
                new_tokens.append(w)
                continue
                
            if w.strip().startswith(("http", "@", "#", "/")):
                new_tokens.append(w)
                continue
                
            clean_w = re.sub(r"[^\w]", "", w)
            if not clean_w:
                if punct_chance > 0:
                    if "!" in w and random.random() < punct_chance:
                        w = w.replace("!", random.choice(["!! ✨", "!! 🥺", "!! >_<"]))
                    if "?" in w and random.random() < punct_chance:
                        w = w.replace("?", random.choice(["? 歪(･ω･)?", "? 🐾", "??"]))
                    if "." in w and "..." not in w and random.random() < punct_chance:
                        w = w.replace(".", random.choice(["...", "~"]))
                new_tokens.append(w)
                continue
                
            lower_clean = clean_w.lower()
            transformed_w = clean_w
            
            if use_kawaii and lower_clean in ALL_DICTS:
                transformed_w = ALL_DICTS[lower_clean]
            elif use_suffix:
                if len(lower_clean) >= 4 and \
                   lower_clean not in STOP_WORDS and \
                   not lower_clean.endswith(verb_endings) and \
                   not lower_clean.endswith(adj_endings) and \
                   not lower_clean.endswith(cute_endings) and \
                   random.random() < (0.35 * intensity):
                    
                    if lower_clean.endswith(("а", "я")):
                        transformed_w = clean_w[:-1] + ("очка" if lower_clean.endswith("а") else "ечка")
                    elif lower_clean.endswith("ь"):
                        transformed_w = clean_w[:-1] + "ька"
                    elif lower_clean.endswith(("к", "г", "х", "ж", "ш", "щ", "ч")):
                        transformed_w = clean_w + "ок" if lower_clean.endswith(("шок", "жок")) else clean_w + "ик"
                    elif lower_clean.endswith(("т", "д", "н", "л", "р", "с", "з", "м", "в", "б", "п", "ф")):
                        transformed_w = clean_w + "чик"
                    else:
                        transformed_w = clean_w + "ик"

            if use_nyacator:
                transformed_w = transformed_w.replace("на", "ня").replace("ма", "мя")
                transformed_w = transformed_w.replace("На", "Ня").replace("Ма", "Мя")
            
            if not first_word_processed and len(transformed_w) > 2 and random.random() < (0.15 * intensity):
                transformed_w = transformed_w[0] + "-" + transformed_w.lower()
            first_word_processed = True

            if clean_w[0].isupper() and transformed_w:
                transformed_w = transformed_w[0].upper() + transformed_w[1:]
                
            leading_punct = re.match(r"^([^\w]*)", w)
            trailing_punct = re.search(r"([^\w]*)$", w)
            l_punct = leading_punct.group(1) if leading_punct else ""
            t_punct = trailing_punct.group(1) if trailing_punct else ""
            
            if punct_chance > 0:
                if "!" in t_punct and random.random() < punct_chance:
                    t_punct = t_punct.replace("!", random.choice(["!! ✨", "!! 🥺", "!! >_<"]))
                if "?" in t_punct and random.random() < punct_chance:
                    t_punct = t_punct.replace("?", random.choice(["? 歪(･ω･)?", "? 🐾", "??"]))
                if "." in t_punct and "..." not in t_punct and random.random() < punct_chance:
                    t_punct = t_punct.replace(".", random.choice(["...", "~"]))
            
            new_tokens.append(l_punct + transformed_w + t_punct)
            
        text = "".join(new_tokens)
        
        if self.get_setting("replace_r_l", True):
            text = re.sub(r"[рР]", "в", text)
            text = re.sub(r"[лЛ]", "в", text)
            
        if self.get_setting("lowercase", True):
            match = re.search(r'[a-zA-Zа-яА-ЯёЁ]', text)
            if match:
                idx = match.start()
                text = text[:idx] + text[idx].lower() + text[idx+1:]
                
        if self.get_setting("upper_case", False):
            text = "".join(c.upper() if random.random() > 0.7 else c.lower() for c in text)
            
        if self.get_setting("add_kaomoji", True) and random.random() < min(0.15 * intensity, 1.0):
            text = random.choice(CUTE_PREFIXES) + text

        if self.get_setting("add_tilde", True):
            if text and text[-1] not in "~!?.)":
                text = text.rstrip() + "~"
                
        if self.get_setting("add_kaomoji", True):
            val = random.random()
            if val < min(0.65 * intensity, 1.0):
                text = text.rstrip("~") + " " + random.choice(KAOMOJI_LIST)
            elif val < min(0.9 * intensity, 1.0):
                text = text.rstrip("~") + " " + random.choice(CUTE_SUFFIXES)
                
        return text

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        result = HookResult()
        
        dialog_id = getattr(params, "dialog_id", None)
        if dialog_id is None:
            dialog_id = getattr(params, "peer_id", None)
        if dialog_id is None:
            dialog_id = getattr(params, "peer", None)
            
        if dialog_id is not None and not self.chat_toggles.get(dialog_id, True):
            return result
            
        try:
            if hasattr(params, "message") and isinstance(params.message, str):
                transformed = self._transform(params.message)
                if transformed != params.message:
                    params.message = transformed
                    result.strategy = HookStrategy.MODIFY
                    result.params = params
        except Exception:
            pass
            
        return result

plugin = YeStylePlugin()