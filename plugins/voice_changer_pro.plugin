DEFAULTS = {
    "enabled": True, "effect": EFFECT_ANON, "scope": 0, "confirm": False,
    "anon_dir": 0, "anon_random": True,
    "x_shift": SHIFT_DEFAULT, "x_speed": 2, "x_volume": 2, "x_tone": 0,
    "x_echo": 0, "x_reverb": 0, "x_noise": 0, "x_fade": True,
    "gate": 0, "trim": False,
    "c_pitch": 5, "c_speed": 5, "c_delay": 0, "c_feedback": 0, "c_reverb": 0,
    "c_robot": 0, "c_vib": 0, "c_radio": False,
    "quality": 0, "notify": True, "send_on_error": False,
}


def _effect_name(eid):
    return f"{EFFECTS[eid][0]} {EFFECTS[eid][1]}"


class VoiceChangerPro(BasePlugin):

    def on_plugin_load(self):
        self._handled = {}
        self._state_lock = threading.Lock()
        self._proc_lock = threading.Lock()
        self._stats = {"ok": 0, "fail": 0, "time": 0.0}
        self._hook_send()
        self._add_menu()
        log(f"{TAG} loaded v{__version__}")

    # ---------- настройки ----------

    def create_settings(self) -> List[Any]:
        items = []
        state = {"div": False}

        def header(text):
            items.append(Header(text=text))
            state["div"] = False

        def switch(**kw):
            items.append(Switch(**kw))
            state["div"] = False

        def sel(key, text, default, opts, desc):
            # Selector не умеет подпись, поэтому описание — серым текстом сразу под пунктом
            items.append(Selector(key=key, text=text, default=default, items=opts))
            try:
                items.append(Divider(text=desc))
                state["div"] = True
            except TypeError:
                state["div"] = False

        def end_section(note=None):
            if note:
                try:
                    items.append(Divider(text=note))
                    state["div"] = True
                    return
                except TypeError:
                    pass
            if not state["div"]:
                items.append(Divider())
                state["div"] = True

        header("Основное")
        switch(key="enabled", text="Менять голос", default=True,
               subtext="Голосовые обрабатываются перед отправкой")
        sel("effect", "Голос", EFFECT_ANON, EFFECT_ITEMS,
            "Какой голос применять. 🕶️ Аноним и 🥷 Аноним+ — маскировка личности, 🔐 Шифр — речь "
            "не разобрать, 🎲 Случайный — новый голос каждый раз. Быстро сменить: меню чата → «Смена голоса».")
        sel("scope", "Где менять голос", 0, SCOPE_ITEMS,
            "Во всех чатах, только в личных или только в группах и каналах.")
        switch(key="confirm", text="Спрашивать перед отправкой", default=False,
               subtext="Окно: с эффектом / оригинал / отмена")
        end_section()

        header("Режим «Аноним» / «Аноним+»")
        sel("anon_dir", "Направление высоты", 0, ANON_DIR_ITEMS,
            "Куда сдвигать голос. «Случайно» — сторона выбирается заново для каждого сообщения.")
        switch(key="anon_random", text="Случайные параметры", default=True,
               subtext="Каждое сообщение звучит чуть иначе — их нельзя связать по тембру")
        end_section()

        header("Подстройка поверх любого голоса")
        sel("x_shift", "Сдвиг высоты (полутоны)", SHIFT_DEFAULT, SHIFT_ITEMS,
            "Поднимает или опускает голос выбранного эффекта. 12 полутонов — ровно одна октава.")
        sel("x_speed", "Скорость речи", 2, XSPEED_ITEMS,
            "Ускоряет или замедляет речь, не меняя высоту. Удобно, чтобы сжать длинные голосовые.")
        sel("x_volume", "Громкость", 2, VOLUME_ITEMS,
            "Итоговая громкость голосового после всех эффектов.")
        sel("x_tone", "Тембр", 0, TONE_ITEMS,
            "Тёплый — глуше и мягче, Яркий — звонче и чётче, Телефон — как через трубку.")
        sel("x_echo", "Добавить эхо", 0, XECHO_ITEMS,
            "Повторы голоса с небольшой задержкой поверх любого эффекта.")
        sel("x_reverb", "Добавить реверберацию", 0, XREVERB_ITEMS,
            "Гулкость помещения: от комнаты до пещеры.")
        sel("x_noise", "Добавить шум / помехи", 0, XNOISE_ITEMS,
            "Фоновое шипение. Голос звучит грязнее и труднее узнаётся.")
        switch(key="x_fade", text="Плавное начало и конец", default=True,
               subtext="Убирает щелчки на стыках")
        end_section()

        header("Очистка звука")
        sel("gate", "Подавление фонового шума", 0, GATE_ITEMS,
            "Приглушает шум между словами (вентилятор, улица, комната). Чем сильнее, тем тише паузы.")
        switch(key="trim", text="Обрезать тишину по краям", default=False,
               subtext="Убирает паузы в начале и конце. Работает и при голосе «Выкл»")
        end_section()

        header("Голос «Свой»")
        sel("c_pitch", "Высота", 5, PITCH_ITEMS,
            "Меньше 1.0x — голос ниже, больше 1.0x — выше.")
        sel("c_speed", "Скорость", 5, SPEED_ITEMS,
            "Скорость речи. Высота голоса при этом не меняется.")
        sel("c_delay", "Эхо: задержка", 0, DELAY_ITEMS,
            "Через сколько миллисекунд голос повторяется. Работает вместе с «Эхо: повторы».")
        sel("c_feedback", "Эхо: повторы", 0, FEEDBACK_ITEMS,
            "Сколько повторов эха и насколько они громкие.")
        sel("c_reverb", "Реверберация", 0, REVERB_ITEMS,
            "Гулкость помещения: чем больше, тем сильнее «зал».")
        sel("c_robot", "Робот (несущая)", 0, ROBOT_ITEMS,
            "Частота металлической модуляции. Ниже — грубее и «злее», выше — звонче.")
        sel("c_vib", "Вибрато", 0, VIB_ITEMS,
            "Лёгкое дрожание высоты голоса.")
        switch(key="c_radio", text="Эффект рации", default=False,
               subtext="Узкая полоса, сжатие и шум, как в рации")
        end_section()

        header("Обработка")
        sel("quality", "Качество / скорость", 0, QUALITY_ITEMS,
            "16 кГц — быстро, 48 кГц — чище звук, но дольше ждать перед отправкой.")
        switch(key="notify", text="Показывать уведомления", default=True,
               subtext="«Обработка голоса…» и сообщения об ошибках")
        switch(key="send_on_error", text="При ошибке отправить оригинал", default=False,
               subtext="Выключено: если обработка не удалась, оригинальный голос НЕ уйдёт")
        end_section()

        header("Сервис")
        try:
            items.append(Text(text="Самопроверка", on_click=lambda *a, **k: self._selfcheck()))
            state["div"] = False
        except Exception:
            log(f"{TAG} Text item failed: {traceback.format_exc()}")
        try:
            try:
                items.append(Text(text="Сбросить настройки", red=True,
                                  on_click=lambda *a, **k: self._reset_settings()))
            except TypeError:
                items.append(Text(text="Сбросить настройки",
                                  on_click=lambda *a, **k: self._reset_settings()))
            state["div"] = False
        except Exception:
            log(f"{TAG} Text item failed: {traceback.format_exc()}")
        end_section("Самопроверка проверяет кодек и обработку на тестовом звуке. "
                    "«Сбросить настройки» возвращает всё по умолчанию.")
        return items

    def build_spec(self, effect_id, rng):
        get = self.get_setting
        if effect_id == EFFECT_RANDOM:
            effect_id = rng.choice(RANDOM_POOL)
            log(f"{TAG} random voice -> {EFFECTS[effect_id][1]}")
        if effect_id in (EFFECT_ANON, EFFECT_ANON_MAX):
            base = _anon_spec(effect_id == EFFECT_ANON_MAX, int(get("anon_dir", 0)),
                              bool(get("anon_random", True)), rng)
        elif effect_id == EFFECT_CUSTOM:
            base = _custom_spec(get)
        else:
            base = dict(EFFECTS.get(effect_id, EFFECTS[EFFECT_NONE])[3])
        return _apply_overlays(base, get)

    def _cleanup_active(self):
        if int(self.get_setting("gate", 0)) > 0 or self.get_setting("trim", False):
            return True
        spec = _apply_overlays({}, self.get_setting)
        spec.pop("fade", None)
        return bool(spec)

    # ---------- настройки для отдельных чатов ----------

    def _overrides(self):
        try:
            d = json.loads(self.get_setting("chat_map", "{}") or "{}")
            return d if isinstance(d, dict) else {}
        except Exception:
            return {}

    def _save_overrides(self, d):
        self.set_setting("chat_map", json.dumps(d))

    def _resolve_effect(self, peer):
        """Эффект для чата; None = в этом чате ничего не менять."""
        effect = int(self.get_setting("effect", EFFECT_ANON))
        ov = self._overrides().get(str(peer))
        if ov is not None:
            return None if int(ov) == EFFECT_NONE else int(ov)
        scope = int(self.get_setting("scope", 0))
        if (scope == 1 and peer < 0) or (scope == 2 and peer > 0):
            return None
        return effect

    # ---------- меню чата ----------

    def _add_menu(self):
        for text, fn in (("Смена голоса", self._show_effect_dialog),
                         ("Голос в этом чате", self._show_chat_dialog)):
            try:
                self.add_menu_item(MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    text=text,
                    on_click=lambda *a, f=fn, **k: f(),
                ))
            except Exception:
                log(f"{TAG} menu item '{text}' failed: {traceback.format_exc()}")

    @staticmethod
    def _listener(fn):
        OnClick = jclass("android.content.DialogInterface$OnClickListener")

        class _Listener(dynamic_proxy(OnClick)):
            def onClick(self, dialog, which):
                try:
                    fn(int(which))
                except Exception:
                    log(f"{TAG} dialog callback failed: {traceback.format_exc()}")

        return _Listener()

    def _builder(self):
        frag = get_last_fragment()
        activity = frag.getParentActivity()
        Builder = find_class("org.telegram.ui.ActionBar.AlertDialog$Builder")
        return Builder(activity), frag

    def _show_list_dialog(self, title, labels, on_pick):
        try:
            builder, _ = self._builder()
            builder.setTitle(title)
            arr = jarray(jclass("java.lang.CharSequence"))(labels)
            builder.setItems(arr, self._listener(on_pick))
            builder.setNegativeButton("Отмена", None)
            builder.show()
        except Exception:
            log(f"{TAG} dialog failed: {traceback.format_exc()}")

    def _show_effect_dialog(self):
        current = int(self.get_setting("effect", EFFECT_ANON))
        enabled = bool(self.get_setting("enabled", True))
        labels = [("✓ " if (i == current and enabled) else "") + _effect_name(i)
                  for i in range(len(EFFECTS))]
        self._show_list_dialog("Смена голоса", labels, self._select_effect)

    def _select_effect(self, effect_id):
        self.set_setting("effect", effect_id)
        self.set_setting("enabled", effect_id != EFFECT_NONE)
        self._toast(f"Голос: {_effect_name(effect_id)}", force=True)

    def _show_chat_dialog(self):
        try:
            did = int(get_last_fragment().getDialogId())
        except Exception:
            self._toast("Открой этот пункт внутри чата", force=True)
            return
        ov = self._overrides().get(str(did))
        labels = ["↩️ По умолчанию" + (" ✓" if ov is None else ""),
                  "🔇 Выключить в этом чате" + (" ✓" if ov is not None and int(ov) == 0 else "")]
        for i in range(1, len(EFFECTS)):
            labels.append(("✓ " if ov is not None and int(ov) == i else "") + _effect_name(i))

        def pick(k):
            d = self._overrides()
            if k == 0:
                d.pop(str(did), None)
                msg = "В этом чате: по умолчанию"
            elif k == 1:
                d[str(did)] = EFFECT_NONE
                msg = "В этом чате голос не меняется"
            else:
                d[str(did)] = k - 1
                msg = f"В этом чате: {_effect_name(k - 1)}"
            self._save_overrides(d)
            self._toast(msg, force=True)

        self._show_list_dialog("Голос в этом чате", labels, pick)

    # ---------- перехват отправки ----------

    def _hook_send(self):
        plugin = self

        class SendHook(MethodHook):
            def before_hooked_method(self, param):
                try:
                    plugin._on_before_send(param)
                except Exception:
                    log(f"{TAG} hook error: {traceback.format_exc()}")

        hook = SendHook()
        cls = find_class("org.telegram.messenger.SendMessagesHelper")
        try:
            self.hook_all_methods(cls, "sendMessage", hook)
            log(f"{TAG} hooked SendMessagesHelper.sendMessage")
            return
        except Exception:
            log(f"{TAG} hook_all_methods failed: {traceback.format_exc()}")
        try:
            jc = jclass("java.lang.Class").forName("org.telegram.messenger.SendMessagesHelper")
            count = 0
            for m in jc.getDeclaredMethods():
                if str(m.getName()) == "sendMessage" and int(m.getParameterCount()) == 1:
                    self.hook_method(m, hook)
                    count += 1
            log(f"{TAG} hooked via reflection: {count} method(s)")
        except Exception:
            log(f"{TAG} reflection hook failed: {traceback.format_exc()}")

    @staticmethod
    def _voice_attr(doc):
        attrs = doc.attributes
        if attrs is None:
            return None
        for i in range(int(attrs.size())):
            a = attrs.get(i)
            if str(a.getClass().getSimpleName()).startswith("TL_documentAttributeAudio"):
                return a
        return None

    @staticmethod
    def _signature(path):
        return (os.path.getsize(path), int(os.path.getmtime(path)))

    def _on_before_send(self, param):
        if not self.get_setting("enabled", True):
            return
        args = param.args
        if args is None or len(args) != 1:
            return
        p = args[0]
        try:
            doc = p.document
            path = p.path
        except Exception:
            return
        if doc is None or not path:
            return
        path = str(path)
        attr = self._voice_attr(doc)
        if attr is None or not bool(attr.voice) or not os.path.isfile(path):
            return
        try:
            peer = int(p.peer)
        except Exception:
            peer = 0
        effect = self._resolve_effect(peer)
        if effect is None:
            return
        if effect == EFFECT_NONE and not self._cleanup_active():
            return
        with self._state_lock:
            if self._handled.get(path) == self._signature(path):
                return  # уже обработано — отправка идёт дальше

        helper = param.thisObject
        try:
            param.setResult(None)  # отменяем отправку, пока обрабатываем
        except Exception:
            log(f"{TAG} setResult unavailable, processing inline")
            self._transform(doc, path, effect)
            return
        if self.get_setting("confirm", False):
            self._ask_confirm(helper, p, doc, path, effect)
        else:
            self._start_worker(helper, p, doc, path, effect)

    def _start_worker(self, helper, params, doc, path, effect):
        threading.Thread(target=self._worker, args=(helper, params, doc, path, effect),
                         daemon=True).start()

    def _ask_confirm(self, helper, p, doc, path, effect):
        plugin = self

        def show():
            try:
                builder, _ = plugin._builder()
                builder.setTitle("Отправить голосовое?")
                builder.setMessage("Голос: " + _effect_name(effect))

                def with_fx(_):
                    plugin._start_worker(helper, p, doc, path, effect)

                def original(_):
                    plugin._mark(path)
                    run_on_ui_thread(lambda: helper.sendMessage(p))

                builder.setPositiveButton("С эффектом", plugin._listener(with_fx))
                builder.setNeutralButton("Оригинал", plugin._listener(original))
                builder.setNegativeButton("Отмена", plugin._listener(lambda _: None))
                builder.show()
            except Exception:
                log(f"{TAG} confirm dialog failed: {traceback.format_exc()}")
                plugin._start_worker(helper, p, doc, path, effect)

        run_on_ui_thread(show)

    def _worker(self, helper, params, doc, path, effect):
        self._toast("Обработка голоса…")
        ok = self._transform(doc, path, effect)
        if ok:
            run_on_ui_thread(lambda: helper.sendMessage(params))

    def _transform(self, doc, path, effect):
        t0 = time.time()
        try:
            with self._proc_lock:
                seconds = _process_voice_file(self, path, effect)
            self._update_doc(doc, path, seconds)
            self._mark(path)
            self._stats["ok"] += 1
            self._stats["time"] += time.time() - t0
            return True
        except Exception:
            self._stats["fail"] += 1
            log(f"{TAG} processing failed: {traceback.format_exc()}")
            if self.get_setting("send_on_error", False):
                self._mark(path)
                self._toast("Не удалось изменить голос — отправлен оригинал", force=True)
                return True
            self._toast("Не удалось изменить голос — сообщение не отправлено", force=True)
            return False

    def _mark(self, path):
        with self._state_lock:
            self._handled[path] = self._signature(path)
            if len(self._handled) > 200:
                for k in list(self._handled)[:100]:
                    self._handled.pop(k, None)

    def _update_doc(self, doc, path, seconds):
        try:
            doc.size = int(os.path.getsize(path))
        except Exception:
            pass
        try:
            attr = self._voice_attr(doc)
            if attr is not None:
                attr.duration = int(math.ceil(seconds))
        except Exception:
            pass

    # ---------- сервис ----------

    def _selfcheck(self):
        def work():
            try:
                self._toast("Самопроверка…", force=True)
                t0 = time.time()
                sr = 16000
                x = array.array('h', [
                    int(6000 * (math.sin(2 * math.pi * 140 * i / sr)
                                + 0.5 * math.sin(2 * math.pi * 280 * i / sr)
                                + 0.3 * math.sin(2 * math.pi * 420 * i / sr))
                        * (0.5 + 0.5 * math.sin(2 * math.pi * 2 * i / sr)))
                    for i in range(sr * 3)]).tobytes()
                rng = random.Random(1)
                effect = int(self.get_setting("effect", EFFECT_ANON))
                if effect == EFFECT_NONE:
                    effect = EFFECT_ANON
                y = run_effects(x, sr, self.build_spec(effect, rng), rng)
                t_dsp = time.time() - t0
                out = _resample(y, sr, NATIVE_SR)
                fd, tmp = tempfile.mkstemp(suffix=".ogg")
                os.close(fd)
                try:
                    _encode_pcm_to_opus(out, tmp)
                    pcm, _sr, _ch = _decode_opus_to_pcm(tmp)
                    if not pcm:
                        raise RuntimeError("декодер вернул пустой звук")
                finally:
                    try:
                        os.remove(tmp)
                    except Exception:
                        pass
                st = self._stats
                self._toast(f"✅ Всё работает. Обработка 3 с звука: {t_dsp:.1f} с. "
                            f"Обработано: {st['ok']}, ошибок: {st['fail']}", force=True)
            except Exception as e:
                log(f"{TAG} selfcheck failed: {traceback.format_exc()}")
                self._toast(f"❌ Ошибка самопроверки: {e}", force=True)

        threading.Thread(target=work, daemon=True).start()

    def _reset_settings(self):
        for k, v in DEFAULTS.items():
            self.set_setting(k, v)
        self.set_setting("chat_map", "{}")
        self._toast("Настройки сброшены. Переоткрой экран плагина", force=True)

    def _toast(self, text, force=False):
        if not force and not self.get_setting("notify", True):
            return
        try:
            run_on_ui_thread(lambda: BulletinHelper.show_info(text))
        except Exception:
            pass
