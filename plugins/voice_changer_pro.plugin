def _anon_spec(strong, direction, randomize, rng):
    """Параметры режима «Аноним». Каждый раз немного разные, чтобы
    сообщения нельзя было связать между собой по одинаковому «тембру»."""
    if direction == 1:
        down = True
    elif direction == 2:
        down = False
    else:
        down = (rng.random() < 0.5) if randomize else True

    def j(a, b):
        return rng.uniform(a, b) if randomize else (a + b) / 2.0

    if strong:
        pitch = j(0.58, 0.68) if down else j(1.38, 1.52)
    else:
        pitch = j(0.68, 0.80) if down else j(1.26, 1.38)

    spec = {
        "pitch": pitch,
        "speed": j(0.97, 1.04),
        "hp": j(130, 200),
        "lp": j(3400, 4200),
        "noise": 0.004,
    }
    d = j(0.5, 0.9)
    spec["vib"] = (j(4.5, 6.5), d, d, 1.0)
    spec["ring"] = (j(90, 150), j(0.10, 0.18))
    if strong:
        d = j(0.9, 1.4)
        spec["vib"] = (j(5.5, 8.0), d, d, 1.0)
        spec["ring"] = (j(110, 170), j(0.20, 0.30))
        spec["layers"] = [(pitch * j(1.05, 1.09), 0.35)]
        spec["ulaw"] = True
        spec["hp"] = j(180, 240)
        spec["lp"] = j(3000, 3600)
        spec["reverb"] = (0.12, 0.6)
        spec["noise"] = 0.008
    return spec


def _custom_spec(get):
    spec = {
        "pitch": PITCH_VALUES[int(get("c_pitch", 5))],
        "speed": SPEED_VALUES[int(get("c_speed", 5))],
    }
    delay = DELAY_VALUES[int(get("c_delay", 0))]
    fb = FEEDBACK_VALUES[int(get("c_feedback", 0))]
    if delay > 0 and fb > 0:
        spec["echo"] = (delay, fb)
    rev = REVERB_VALUES[int(get("c_reverb", 0))]
    if rev > 0:
        spec["reverb"] = (rev, 1.0)
    robot = ROBOT_VALUES[int(get("c_robot", 0))]
    if robot > 0:
        spec["ring"] = (robot, 0.65)
    vib = VIB_VALUES[int(get("c_vib", 0))]
    if vib > 0:
        spec["vib"] = (5.5, vib, vib, 1.0)
    if get("c_radio", False):
        spec.update({"hp": 350, "lp": 2800, "ulaw": True, "noise": 0.008})
    return spec


def _idx(get, key, default, size):
    try:
        v = int(get(key, default))
    except Exception:
        v = default
    return v if 0 <= v < size else default


def _apply_overlays(spec, get):
    """Настройки «поверх любого голоса»: сдвиг высоты, скорость, тембр, эхо, шум, громкость."""
    spec = dict(spec)
    st = _idx(get, "x_shift", SHIFT_DEFAULT, len(SHIFT_ITEMS)) - 12
    if st:
        mult = 2.0 ** (st / 12.0)
        spec["pitch"] = min(2.6, max(0.35, spec.get("pitch", 1.0) * mult))
        if spec.get("layers"):
            spec["layers"] = [(min(2.6, max(0.35, p * mult)), g) for p, g in spec["layers"]]
    xs = XSPEED_VALUES[_idx(get, "x_speed", 2, len(XSPEED_VALUES))]
    if xs != 1.0:
        spec["speed"] = min(2.5, max(0.5, spec.get("speed", 1.0) * xs))
    tone = _idx(get, "x_tone", 0, len(TONE_ITEMS))
    if tone:
        spec["tone"] = tone
    e = XECHO_VALUES[_idx(get, "x_echo", 0, len(XECHO_VALUES))]
    if e:
        spec["echo"] = e
    r = XREVERB_VALUES[_idx(get, "x_reverb", 0, len(XREVERB_VALUES))]
    if r:
        spec["reverb"] = r
    n = XNOISE_VALUES[_idx(get, "x_noise", 0, len(XNOISE_VALUES))]
    if n:
        spec["noise"] = n
    vol = VOLUME_VALUES[_idx(get, "x_volume", 2, len(VOLUME_VALUES))]
    if vol:
        spec["gain_db"] = vol
    if get("x_fade", True):
        spec["fade"] = True
    return spec


# ──────────────────────────── DSP (чистый Python) ────────────────────────────
# Все функции работают с bytes: моно, int16, native endian.

def _resample(pcm, in_sr, out_sr):
    if in_sr == out_sr or not pcm:
        return pcm
    if in_sr > out_sr and in_sr % out_sr == 0:
        k = in_sr // out_sr
        a = array.array('h')
        a.frombytes(pcm[: len(pcm) // 2 * 2])
        cols = [a[i::k] for i in range(k)]
        return array.array('h', [sum(t) // k for t in zip(*cols)]).tobytes()
    g = math.gcd(in_sr, out_sr)
    return audioop.ratecv(pcm, SAMPLE_WIDTH, 1, in_sr // g, out_sr // g, None)[0]


def _wsola(pcm, sr, alpha, step=None):
    """Растяжение времени в alpha раз с сохранением высоты (WSOLA)."""
    n0 = len(pcm) // 2
    if n0 == 0 or abs(alpha - 1.0) < 0.004:
        return pcm
    N = max(64, int(sr * 0.03) // 2 * 2)
    Hs = N // 2
    tol = max(8, int(sr * 0.006))
    if step is None:
        step = 2 if n0 < sr * 60 else 4
        if sr > 24000:
            step += 1
    if n0 < 3 * N:
        pcm = pcm + bytes(2 * (3 * N - n0))
    n = len(pcm) // 2
    x = array.array('h')
    x.frombytes(pcm)
    win = [0.5 - 0.5 * math.cos(2.0 * math.pi * i / N) for i in range(N)]
    out_len = int(n0 * alpha)
    Ha = Hs / alpha
    K = out_len // Hs + 2
    out = [0.0] * (K * Hs + N)
    rms = audioop.rms
    findfactor = audioop.findfactor
    hi_lim = n - N
    prev = 0
    for k in range(K):
        c = int(k * Ha + 0.5)
        if c > hi_lim:
            c = hi_lim
        best = c
        if k > 0:
            t0 = prev + Hs
            if t0 <= hi_lim:
                target = pcm[2 * t0: 2 * (t0 + N)]
                rt = rms(target, 2)
                if rt > 20:
                    lo = max(0, c - tol)
                    hi = min(hi_lim, c + tol)
                    bc = -2.0
                    for cand in range(lo, hi + 1, step):
                        seg = pcm[2 * cand: 2 * (cand + N)]
                        ra = rms(seg, 2)
                        if ra:
                            corr = findfactor(seg, target) * rt / ra
                            if corr > bc:
                                bc = corr
                                best = cand
        frame = x[best: best + N]
        o = k * Hs
        out[o: o + N] = [s + f * w for s, f, w in zip(out[o: o + N], frame, win)]
        prev = best
    res = out[:out_len]
    return array.array(
        'h', [32767 if v > 32767 else (-32768 if v < -32768 else int(v)) for v in res]
    ).tobytes()


def _pitch_time(pcm, sr, pitch, speed):
    """Смена высоты (pitch>1 выше) и скорости (speed>1 быстрее)."""
    alpha = pitch / speed
    if abs(alpha - 1.0) >= 0.004:
        pcm = _wsola(pcm, sr, alpha)
    if abs(pitch - 1.0) >= 0.004:
        fr = Fraction(pitch).limit_denominator(200)
        pcm = audioop.ratecv(pcm, SAMPLE_WIDTH, 1, fr.numerator, fr.denominator, None)[0]
    return pcm


def _amp_mod(pcm, sr, rate, lo, hi):
    """Амплитудная модуляция: множитель качается между lo и hi."""
    period = max(2, int(round(sr / rate)))
    mid = (hi + lo) / 2.0
    amp = (hi - lo) / 2.0
    table = [mid + amp * math.sin(2.0 * math.pi * i / period) for i in range(period)]
    x = array.array('h')
    x.frombytes(pcm)
    return array.array('h', [int(a * b) for a, b in zip(x, itertools.cycle(table))]).tobytes()


def _mod_delay(pcm, sr, rate, depth_ms, base_ms, mix):
    """Линия задержки с модуляцией: вибрато (mix=1) или хорус/флэнжер."""
    x = array.array('h')
    x.frombytes(pcm)
    n = len(x)
    if n < 8:
        return pcm
    depth = sr * depth_ms / 1000.0
    base = max(sr * base_ms / 1000.0, depth)
    w = 2.0 * math.pi * rate / sr
    sin = math.sin
    dry = 1.0 - mix
    last = n - 1
    out = array.array('h')
    ap = out.append
    for i in range(n):
        p = i - (base + depth * sin(w * i))
        if p < 0.0:
            p = 0.0
        j = int(p)
        if j >= last:
            y = x[last]
        else:
            y = x[j] + (x[j + 1] - x[j]) * (p - j)
        v = int(dry * x[i] + mix * y)
        ap(32767 if v > 32767 else (-32768 if v < -32768 else v))
    return out.tobytes()


def _lowpass(pcm, sr, fc, poles=1):
    fc = min(fc, sr * 0.45)
    a = 1.0 - math.exp(-2.0 * math.pi * fc / sr)
    x = array.array('h')
    x.frombytes(pcm)
    for _ in range(max(1, poles)):
        y = 0.0
        out = array.array('h')
        ap = out.append
        for v in x:
            y += a * (v - y)
            ap(int(y))
        x = out
    return x.tobytes()


def _highpass(pcm, sr, fc):
    a = 1.0 - math.exp(-2.0 * math.pi * fc / sr)
    x = array.array('h')
    x.frombytes(pcm)
    lp = 0.0
    out = array.array('h')
    ap = out.append
    for v in x:
        lp += a * (v - lp)
        o = int(v - lp)
        ap(32767 if o > 32767 else (-32768 if o < -32768 else o))
    return out.tobytes()


def _bitcrush(pcm, sr, target_hz, bits):
    x = array.array('h')
    x.frombytes(pcm)
    n = len(x)
    hold = max(1, int(round(sr / float(target_hz))))
    if hold > 1:
        y = array.array('h', bytes(2 * n))
        src = x[::hold]
        for k in range(hold):
            y[k::hold] = src[: len(range(k, n, hold))]
        x = y
    if bits < 16:
        mask = -(1 << (16 - bits))
        x = array.array('h', [v & mask for v in x])
    return x.tobytes()


def _add_noise(pcm, level):
    noise = audioop.mul(os.urandom(len(pcm)), SAMPLE_WIDTH, level)
    return audioop.add(pcm, noise, SAMPLE_WIDTH)


def _multitap(pcm, sr, taps, dry=1.0):
    """Сумма задержанных копий: эхо и реверберация на скорости C (audioop)."""
    if not taps:
        return pcm
    maxd = max(int(sr * d / 1000.0) for d, _ in taps)
    total = len(pcm) + 2 * maxd
    acc = audioop.mul(pcm + bytes(total - len(pcm)), SAMPLE_WIDTH, dry)
    for d_ms, g in taps:
        d = int(sr * d_ms / 1000.0) * 2
        sh = bytes(d) + pcm
        sh += bytes(total - len(sh))
        acc = audioop.add(acc, audioop.mul(sh, SAMPLE_WIDTH, g), SAMPLE_WIDTH)
    return acc


def _echo(pcm, sr, delay_ms, fb):
    taps = []
    g = fb
    k = 1
    while g >= 0.04 and k <= 14:
        taps.append((delay_ms * k, g))
        g *= fb
        k += 1
    return _multitap(pcm, sr, taps)


_REVERB_TAPS = [(19, 0.55), (29, -0.5), (41, 0.45), (53, -0.4), (67, 0.36), (83, -0.32),
                (101, 0.28), (127, -0.24), (151, 0.2), (181, -0.17), (211, 0.14),
                (251, -0.11), (293, 0.09), (347, -0.07)]


def _reverb(pcm, sr, mix, size):
    taps = [(d * size, g * mix * 0.8) for d, g in _REVERB_TAPS]
    return _multitap(pcm, sr, taps, dry=1.0 - 0.4 * mix)


def _scramble(pcm, sr, rng):
    """Режем речь на куски по ~100 мс, разворачиваем каждый и местами меняем соседей."""
    n = len(pcm)
    blocks = []
    pos = 0
    fade = max(8, int(sr * 0.004))
    while pos < n:
        b = int(sr * rng.uniform(0.07, 0.13)) * 2
        blk = array.array('h')
        blk.frombytes(audioop.reverse(pcm[pos: pos + b], SAMPLE_WIDTH))
        m = len(blk)
        f = min(fade, m // 2)
        for i in range(f):
            g = i / float(f)
            blk[i] = int(blk[i] * g)
            blk[m - 1 - i] = int(blk[m - 1 - i] * g)
        blocks.append(blk.tobytes())
        pos += b
    for i in range(0, len(blocks) - 1, 2):
        if rng.random() < 0.5:
            blocks[i], blocks[i + 1] = blocks[i + 1], blocks[i]
    return b"".join(blocks)


def _match_level(pcm, ref_rms):
    r = audioop.rms(pcm, SAMPLE_WIDTH)
    pk = audioop.max(pcm, SAMPLE_WIDTH)
    if r <= 0 or ref_rms <= 0:
        return pcm
    g = ref_rms / float(r)
    if pk * g > 31000:
        g = 31000.0 / pk
    g = max(0.25, min(g, 8.0))
    if 0.97 < g < 1.03:
        return pcm
    return audioop.mul(pcm, SAMPLE_WIDTH, g)


def _fade(pcm, sr, ms=25):
    x = array.array('h')
    x.frombytes(pcm)
    n = len(x)
    f = min(int(sr * ms / 1000.0), n // 2)
    for i in range(f):
        g = i / float(f)
        x[i] = int(x[i] * g)
        x[n - 1 - i] = int(x[n - 1 - i] * g)
    return x.tobytes()


def _bright(pcm, sr):
    lp = _lowpass(pcm, sr, 1800)
    hf = audioop.add(pcm, audioop.mul(lp, SAMPLE_WIDTH, -1.0), SAMPLE_WIDTH)
    return audioop.add(pcm, audioop.mul(hf, SAMPLE_WIDTH, 1.2), SAMPLE_WIDTH)


def _glitch(pcm, sr, rng):
    """Случайные заедания, обрывы и развороты коротких кусков."""
    out = []
    pos = 0
    n = len(pcm)
    while pos < n:
        b = int(sr * rng.uniform(0.04, 0.12)) * 2
        blk = pcm[pos: pos + b]
        pos += b
        r = rng.random()
        if r < 0.13:
            out.extend([blk] * rng.randint(2, 4))
        elif r < 0.18:
            out.append(bytes(len(blk)))
        elif r < 0.24:
            out.append(audioop.reverse(blk, SAMPLE_WIDTH))
        else:
            out.append(blk)
    return b"".join(out)


def _chunk_levels(pcm, sr):
    C = max(16, int(sr * 0.02))
    cnt = (len(pcm) // 2) // C
    rms = audioop.rms
    return C, cnt, [rms(pcm[i * C * 2:(i + 1) * C * 2], SAMPLE_WIDTH) for i in range(cnt)]


def _gate(pcm, sr, level):
    """Подавление фона: тихие куски (между словами) приглушаются. level 1..3."""
    C, cnt, r = _chunk_levels(pcm, sr)
    if cnt < 6:
        return pcm
    floor = sorted(r)[int(cnt * 0.15)]
    thr = max(floor * (2.0, 3.0, 4.5)[level - 1], 40)
    fgain = (0.4, 0.2, 0.07)[level - 1]
    opened = [max(r[max(0, i - 2): i + 3]) > thr for i in range(cnt)]
    out = []
    gp = 1.0
    for i in range(cnt):
        chunk = pcm[i * C * 2:(i + 1) * C * 2]
        g = 1.0 if opened[i] else fgain
        if g == gp:
            out.append(chunk if g == 1.0 else audioop.mul(chunk, SAMPLE_WIDTH, g))
        else:
            seg = array.array('h')
            seg.frombytes(chunk)
            d = (g - gp) / C
            out.append(array.array('h', [int(v * (gp + d * k)) for k, v in enumerate(seg)]).tobytes())
        gp = g
    rem = pcm[cnt * C * 2:]
    out.append(rem if gp == 1.0 else audioop.mul(rem, SAMPLE_WIDTH, gp))
    return b"".join(out)


def _trim_silence(pcm, sr):
    """Обрезает тишину в начале и конце (оставляя 100 мс запаса)."""
    C, cnt, r = _chunk_levels(pcm, sr)
    if cnt < 10:
        return pcm
    floor = sorted(r)[int(cnt * 0.15)]
    thr = max(floor * 3.0, 60)
    idx = [i for i, v in enumerate(r) if v > thr]
    if not idx:
        return pcm
    a = max(0, idx[0] - 5)
    b = min(cnt, idx[-1] + 6)
    if b - a >= cnt - 2:
        return pcm
    return pcm[a * C * 2: b * C * 2]


def run_effects(pcm, sr, spec, rng):
    """Применяет набор эффектов spec к моно int16 PCM, возвращает bytes."""
    pcm = pcm[: len(pcm) // 2 * 2]
    if not pcm or not spec:
        return pcm
    ref_rms = audioop.rms(pcm, SAMPLE_WIDTH)
    if ref_rms == 0:
        return pcm

    speed = spec.get("speed", 1.0)
    x = _pitch_time(pcm, sr, spec.get("pitch", 1.0), speed)
    for lp_pitch, lp_gain in spec.get("layers", []):
        layer = _pitch_time(pcm, sr, lp_pitch, speed)
        m = min(len(x), len(layer)) // 2 * 2
        x = audioop.add(x[:m], audioop.mul(layer[:m], SAMPLE_WIDTH, lp_gain), SAMPLE_WIDTH)

    if spec.get("reverse"):
        x = audioop.reverse(x, SAMPLE_WIDTH)
    if spec.get("scramble"):
        x = _scramble(x, sr, rng)
    if spec.get("glitch"):
        x = _glitch(x, sr, rng)
    if "ring" in spec:
        freq, mix = spec["ring"]
        x = _amp_mod(x, sr, freq, 1.0 - 2.0 * mix, 1.0)
    if "trem" in spec:
        rate, depth = spec["trem"]
        x = _amp_mod(x, sr, rate, 1.0 - depth, 1.0)
    if "vib" in spec:
        rate, depth_ms, base_ms, mix = spec["vib"]
        x = _mod_delay(x, sr, rate, depth_ms, base_ms, mix)
    if "hp" in spec:
        x = _highpass(x, sr, spec["hp"])
    if "lp" in spec:
        x = _lowpass(x, sr, spec["lp"], spec.get("lp_poles", 1))
    tone = spec.get("tone", 0)
    if tone == 1:
        x = _lowpass(x, sr, 3000)
    elif tone == 2:
        x = _bright(x, sr)
    elif tone == 3:
        x = _lowpass(_highpass(x, sr, 300), sr, 3400)
    if "crush" in spec:
        x = _bitcrush(x, sr, spec["crush"][0], spec["crush"][1])
    if spec.get("ulaw"):
        x = audioop.ulaw2lin(audioop.lin2ulaw(x, SAMPLE_WIDTH), SAMPLE_WIDTH)
    if "drive" in spec:
        x = audioop.mul(x, SAMPLE_WIDTH, spec["drive"])
    if "echo" in spec:
        x = _echo(x, sr, spec["echo"][0], spec["echo"][1])
    if "reverb" in spec:
        x = _reverb(x, sr, spec["reverb"][0], spec["reverb"][1])
    if spec.get("noise"):
        x = _add_noise(x, spec["noise"])
    x = _match_level(x, ref_rms)
    if spec.get("fade"):
        x = _fade(x, sr)
    if spec.get("gain_db"):
        x = audioop.mul(x, SAMPLE_WIDTH, 10.0 ** (spec["gain_db"] / 20.0))
    return x


# ─────────────────────────── Opus / Ogg (Android) ───────────────────────────

def _decode_opus_to_pcm(ogg_path):
    log(f"{TAG} decoding: {ogg_path}")
    MediaExtractor = jclass("android.media.MediaExtractor")
    MediaCodec = jclass("android.media.MediaCodec")
    MediaFormat = jclass("android.media.MediaFormat")

    extractor = MediaExtractor()
    extractor.setDataSource(ogg_path)

    audio_track = -1
    mime = None
    input_format = None
    for i in range(extractor.getTrackCount()):
        fmt = extractor.getTrackFormat(i)
        m = str(fmt.getString(MediaFormat.KEY_MIME))
        if m.startswith("audio/"):
            audio_track, mime, input_format = i, m, fmt
            break
    if audio_track == -1:
        extractor.release()
        return None, NATIVE_SR, 1

    extractor.selectTrack(audio_track)
    sr = NATIVE_SR
    channels = 1
    try:
        sr = int(input_format.getInteger(MediaFormat.KEY_SAMPLE_RATE))
    except Exception as e:
        log(f"{TAG} sample rate unknown: {e}")
    try:
        channels = int(input_format.getInteger(MediaFormat.KEY_CHANNEL_COUNT))
    except Exception as e:
        log(f"{TAG} channel count unknown: {e}")

    codec = MediaCodec.createDecoderByType(mime)
    codec.configure(input_format, None, None, 0)
    codec.start()

    chunks = []
    TIMEOUT = 10000
    info = MediaCodec.BufferInfo()
    eos_in = False
    eos_out = False
    deadline = time.time() + 120
    try:
        while not eos_out:
            if time.time() > deadline:
                raise RuntimeError("decode timeout")
            if not eos_in:
                idx = codec.dequeueInputBuffer(TIMEOUT)
                if idx >= 0:
                    buf = codec.getInputBuffer(idx)
                    buf.clear()
                    n = extractor.readSampleData(buf, 0)
                    if n < 0:
                        codec.queueInputBuffer(idx, 0, 0, 0, 4)
                        eos_in = True
                    else:
                        codec.queueInputBuffer(idx, 0, n, extractor.getSampleTime(), 0)
                        extractor.advance()
            out_idx = codec.dequeueOutputBuffer(info, TIMEOUT)
            if out_idx >= 0:
                out_buf = codec.getOutputBuffer(out_idx)
                out_buf.position(info.offset)
                out_buf.limit(info.offset + info.size)
                chunk = bytearray(info.size)
                out_buf.get(chunk)
                chunks.append(bytes(chunk))
                codec.releaseOutputBuffer(out_idx, False)
                if (info.flags & 4) != 0:
                    eos_out = True
    finally:
        try:
            codec.stop()
            codec.release()
        except Exception:
            pass
        extractor.release()

    pcm = b"".join(chunks)
    log(f"{TAG} decoded bytes={len(pcm)} sr={sr} ch={channels}")
    return pcm, sr, channels


_CRC_TABLE = []
for _i in range(256):
    _r = _i << 24
    for _ in range(8):
        _r = ((_r << 1) ^ 0x04C11DB7) if (_r & 0x80000000) else (_r << 1)
        _r &= 0xFFFFFFFF
    _CRC_TABLE.append(_r)


def ogg_crc(data, crc=0):
    tbl = _CRC_TABLE
    for b in data:
        crc = ((crc << 8) & 0xFFFFFFFF) ^ tbl[((crc >> 24) ^ b) & 0xFF]
    return crc


def make_ogg_page(serial, seq, granule, flags, packets):
    segment_table = bytearray()
    payload = bytearray()
    for p in packets:
        l = len(p)
        while l >= 255:
            segment_table.append(255)
            l -= 255
        segment_table.append(l)
        payload.extend(p)
    header = bytearray(b'OggS')
    header.append(0)
    header.append(flags)
    header.extend(struct.pack('<Q', granule))
    header.extend(struct.pack('<I', serial))
    header.extend(struct.pack('<I', seq))
    header.extend(struct.pack('<I', 0))
    header.append(len(segment_table))
    header.extend(segment_table)
    crc = ogg_crc(header + payload)
    struct.pack_into('<I', header, 22, crc)
    return header + payload


def _encode_pcm_to_opus(pcm, out_path):
    """pcm: моно int16 48 кГц -> Ogg/Opus файл (как записывает Telegram)."""
    log(f"{TAG} encoding -> {out_path} pcm_bytes={len(pcm)}")
    MediaCodec = jclass("android.media.MediaCodec")
    MediaFormat = jclass("android.media.MediaFormat")

    fmt = MediaFormat.createAudioFormat("audio/opus", NATIVE_SR, 1)
    fmt.setInteger(MediaFormat.KEY_BIT_RATE, 32000)
    fmt.setInteger(MediaFormat.KEY_MAX_INPUT_SIZE, 65536)

    codec = MediaCodec.createEncoderByType("audio/opus")
    codec.configure(fmt, None, None, 1)
    codec.start()

    serial = 0x12345678
    opus_head = bytearray(b'OpusHead')
    opus_head.append(1)
    opus_head.append(1)
    opus_head.extend(struct.pack('<H', 312))
    opus_head.extend(struct.pack('<I', 48000))
    opus_head.extend(struct.pack('<H', 0))
    opus_head.append(0)

    opus_tags = bytearray(b'OpusTags')
    opus_tags.extend(struct.pack('<I', 8))
    opus_tags.extend(b'exteraGr')
    opus_tags.extend(struct.pack('<I', 0))

    try:
        with open(out_path, "wb") as f:
            f.write(make_ogg_page(serial, 0, 0, 2, [opus_head]))
            f.write(make_ogg_page(serial, 1, 0, 0, [opus_tags]))

            TIMEOUT = 10000
            info = MediaCodec.BufferInfo()
            chunk_size = 960 * SAMPLE_WIDTH
            eos_in = False
            eos_out = False
            offset = 0
            total = len(pcm)
            pts = 0
            seq = 2
            granule = 0
            deadline = time.time() + 180

            while not eos_out:
                if time.time() > deadline:
                    raise RuntimeError("encode timeout")
                if not eos_in:
                    idx = codec.dequeueInputBuffer(TIMEOUT)
                    if idx >= 0:
                        buf = codec.getInputBuffer(idx)
                        buf.clear()
                        rem = total - offset
                        if rem <= 0:
                            codec.queueInputBuffer(idx, 0, 0, pts, 4)
                            eos_in = True
                        else:
                            n = min(chunk_size, rem)
                            buf.put(bytearray(pcm[offset: offset + n]))
                            codec.queueInputBuffer(idx, 0, n, pts, 0)
                            pts += (n // SAMPLE_WIDTH) * 1000000 // NATIVE_SR
                            offset += n

                out_idx = codec.dequeueOutputBuffer(info, TIMEOUT)
                if out_idx >= 0:
                    if (info.flags & 2) == 0:
                        out_buf = codec.getOutputBuffer(out_idx)
                        out_buf.position(info.offset)
                        out_buf.limit(info.offset + info.size)
                        chunk = bytearray(info.size)
                        out_buf.get(chunk)
                        is_eos = (info.flags & 4) != 0
                        granule += 960
                        f.write(make_ogg_page(serial, seq, granule, 4 if is_eos else 0, [chunk]))
                        seq += 1
                    codec.releaseOutputBuffer(out_idx, False)
                    if (info.flags & 4) != 0:
                        eos_out = True
    finally:
        try:
            codec.stop()
            codec.release()
        except Exception:
            pass


def _process_voice_file(plugin, path, effect_id):
    """Перекодирует файл голосового на месте. Возвращает длительность (сек)."""
    if not os.path.isfile(path) or os.path.getsize(path) == 0:
        raise RuntimeError("voice file is missing or empty")
    t0 = time.time()

    pcm, sr, channels = _decode_opus_to_pcm(path)
    if not pcm:
        raise RuntimeError("decoded PCM is empty")
    pcm = pcm[: len(pcm) // 2 * 2]
    if channels == 2:
        pcm = audioop.tomono(pcm, SAMPLE_WIDTH, 0.5, 0.5)

    q = int(plugin.get_setting("quality", 0))
    q = 0 if q < 0 or q >= len(DSP_RATES) else q
    dsp_sr = DSP_RATES[q] or sr
    if dsp_sr > sr:
        dsp_sr = sr

    rng = random.Random(os.urandom(16))
    spec = plugin.build_spec(effect_id, rng)
    log(f"{TAG} effect={effect_id} dsp_sr={dsp_sr} spec={spec}")

    x = _resample(pcm, sr, dsp_sr)
    if plugin.get_setting("trim", False):
        x = _trim_silence(x, dsp_sr)
    gate = _idx(plugin.get_setting, "gate", 0, len(GATE_ITEMS))
    if gate > 0:
        x = _gate(x, dsp_sr, gate)
    y = run_effects(x, dsp_sr, spec, rng)
    out = _resample(y, dsp_sr, NATIVE_SR)

    tmp = path + ".vc_tmp"
    try:
        _encode_pcm_to_opus(out, tmp)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            try:
                os.remove(tmp)
            except Exception:
                pass
    seconds = len(out) / 2.0 / NATIVE_SR
    log(f"{TAG} done in {time.time() - t0:.2f}s, {seconds:.1f}s of audio")
    return seconds


